{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyIntendedWorkload",
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-arn": "<CLUSTER_ARN>",
          "aws:RequestTag/kubernetes-namespace": "participant-services",
          "aws:RequestTag/kubernetes-service-account": "participant-api"
        }
      }
    }
  ]
}
